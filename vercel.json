{
  "buildCommand": "node build/build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/league.app.(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/league",
      "destination": "/league.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/universe",
      "destination": "/universe.html"
    },
    {
      "source": "/wrapped",
      "destination": "/wrapped.html"
    }
  ]
}
